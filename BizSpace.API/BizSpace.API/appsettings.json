{
  "Database": {
    "ApplyMigrations": true
  },
  "Jwt": {
    "Issuer": "BizSpace.Api",
    "Audience": "BizSpace.Client",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
